+func TestFirstUserStartsIdleKernel(t *testing.T) {
+	for _, mode := range []string{"full", "delta"} {
+		t.Run(mode, func(t *testing.T) {
+			k := &fakeKernel{running: false}
+			s := newTestService(k)
+			s.lastConfig = &model.NodeSpec{Protocol: "vless", ServerPort: 31200}
+			s.updateUserState(nil)
+			users := []model.UserSpec{{ID: 1, UUID: "first-user", SpeedLimit: 10}}
+			if mode == "full" {
+				s.applyUserUpdate(context.Background(), users, computeUserHash(users))
+			} else {
+				s.applyUserDelta(context.Background(), "add", users)
+			}
+			if !k.running || k.startCalls != 1 || len(s.lastUsers) != 1 || s.lastUsers[0].UUID != "first-user" {
+				t.Fatalf("first user did not start idle kernel: running=%v starts=%d users=%#v", k.running, k.startCalls, s.lastUsers)
+			}
+			if s.speedTracker.GetLimiter("first-user") == nil {
+				t.Fatal("first user must retain its speed limit")
+			}
+		})
+	}
+}
