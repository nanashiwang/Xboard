+func TestIdleKernelFailureRestoresUserState(t *testing.T) {
+	for _, mode := range []string{"full", "delta"} {
+		t.Run(mode, func(t *testing.T) {
+			k := &fakeKernel{startErr: errors.New("start failed")}
+			s := newTestService(k)
+			s.lastConfig = &model.NodeSpec{Protocol: "vless"}
+			s.updateUserState(nil)
+			oldHash := s.lastUserHash
+			users := []model.UserSpec{{ID: 1, UUID: "first-user", SpeedLimit: 10}}
+			if mode == "full" {
+				s.applyUserUpdate(context.Background(), users, computeUserHash(users))
+			} else {
+				s.applyUserDelta(context.Background(), "add", users)
+			}
+			if k.startCalls != 1 || k.running || len(s.lastUsers) != 0 || s.lastUserHash != oldHash {
+				t.Fatal("failed startup did not preserve previous state")
+			}
+			if s.speedTracker.GetLimiter("first-user") != nil {
+				t.Fatal("failed startup leaked new limiter")
+			}
+		})
+	}
+}
