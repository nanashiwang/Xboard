{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capybara",
  "version": "0.1.10",
  "identifier": "us.taige.capybara",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "卡皮巴拉",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/mihomo"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libsecret-1-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "resources": {
      "resources/geoip.metadb": "geoip.metadb",
      "../LICENSE.mihomo": "LICENSE.mihomo",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDMkRENDZENTk5NUU2MzMKUldRejVwVlpiZFF0UE5NZW8wWWYzSnBvRCtPT3R6WGVuSXJHTFpIdEFLdms5SG5jSm1yQzdiMWcK",
      "endpoints": [
        "https://taige.us/downloads/capybara-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
